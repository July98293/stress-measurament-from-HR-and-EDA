# ============================================================
# APPROACH 2 — SUBJECT-WISE Z-SCORE NORMALIZATION
#
# For each subject:
#
#     z = (x - mean_subject) / std_subject
#
# Removes subject-specific physiological bias and
# expresses features as deviations from each subject's
# personal distribution.
# ============================================================

def zscore_per_subject(df, features):

    df = df.copy()

    for subj in df['Subject'].unique():

        mask = df['Subject'] == subj

        subj_data = df.loc[mask, features]

        std = subj_data.std().replace(0, 1)

        df.loc[mask, features] = (
            subj_data - subj_data.mean()
        ) / std

    return df


