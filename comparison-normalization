# ============================================================
# APPROACH 3 — DELTA FROM PERSONAL BASELINE
#
# Baseline:
# Mean of the first N windows for each subject
#
# Delta:
#
#     delta = current_value - personal_baseline
#
# Represents how far the signal deviates from the
# subject's physiological resting state.
# ============================================================

def add_delta_features(df, features, n_baseline=20):

    df = df.copy()

    delta_features = [f'delta_{f}' for f in features]

    for subj in df['Subject'].unique():

        mask = df['Subject'] == subj

        subj_data = df.loc[mask, features]

        baseline = subj_data.iloc[:n_baseline].mean()

        df.loc[mask, delta_features] = (
            subj_data.values - baseline.values
        )

    return df, delta_features


