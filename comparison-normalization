# ============================================================
# NORMALIZATION APPROACH COMPARISON
# ============================================================

def train_and_score(X_tr, y_tr, X_te, y_te, label):

    model = lgb.LGBMClassifier(
        objective='binary',
        n_estimators=500,
        learning_rate=0.05,
        num_leaves=63,
        verbose=-1,
        random_state=42,
        n_jobs=-1
    )

    model.fit(
        X_tr,
        y_tr,
        eval_set=[(X_te, y_te)],
        callbacks=[
            lgb.early_stopping(50, verbose=False),
            lgb.log_evaluation(-1)
        ]
    )

    y_pred = model.predict(X_te)
    y_prob = model.predict_proba(X_te)[:, 1]

    acc = accuracy_score(y_te, y_pred)
    f1  = f1_score(y_te, y_pred)
    auc = roc_auc_score(y_te, y_prob)

    print(f"{label:<35} "
          f"acc={acc:.4f}  "
          f"f1={f1:.4f}  "
          f"auc={auc:.4f}")

    return model, acc, f1, auc


